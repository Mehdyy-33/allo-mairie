generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String
  category    String
  description String
  createdAt   DateTime @default(now())
  status      String   @default("Reçue")
  filePath    String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  nom        String?
  prenom     String?
  createdAt  DateTime  @default(now())
  isComplete Boolean   @default(false)

  communeId  Int?
  commune    Commune?  @relation(fields: [communeId], references: [id])

  requests   Request[]

  googleId   String?   // ✅ Ajouté ici
}

model Commune {
  id          Int           @id @default(autoincrement())
  nom         String        @unique
  active      Boolean       @default(true)
  users       User[]
  invitations Invitation[]  // ← ajouter cette ligne
}

model Invitation {
  id         Int       @id @default(autoincrement())
  email      String
  token      String    @unique
  communeId  Int
  commune    Commune   @relation(fields: [communeId], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
}