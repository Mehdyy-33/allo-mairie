generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String
  category    String
  description String
  status      String   @default("Reçue")  // ✅ Nouveau champ
  createdAt   DateTime @default(now())
}

